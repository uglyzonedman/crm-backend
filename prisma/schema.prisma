generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  name               String?
  surName            String?
  lastName           String?
  login              String     @unique
  createdAt          DateTime   @default(now())
  isActivated        Boolean    @default(false) @map("is_activated")
  activatedEmailCode String     @default("") @map("activated_email_code")
  AuthCode           AuthCode[]

  @@map("user")
}

model AuthCode {
  id        Int      @id @default(autoincrement())
  code      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([code])
  @@map("auth_code")
}
