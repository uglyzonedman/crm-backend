generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  name               String?
  surName            String?
  password           String
  lastName           String?
  login              String        @unique
  createdAt          DateTime      @default(now())
  isActivated        Boolean       @default(false) @map("is_activated")
  activatedEmailCode String        @default("") @map("activated_email_code")
  AuthCode           AuthCode[]
  SessionUser        SessionUser[]
  roleId             String
  role               Role          @relation(fields: [roleId], references: [id])
  @@map("user")
}

model SessionUser {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  @@map("session_user")
}

model AuthCode {
  id        Int      @id @default(autoincrement())
  code      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([code])
  @@map("auth_code")
}

model PendingUser {
  id         String   @id @default(uuid())
  email      String   @unique
  isActivatedCode Boolean @default(false) @map("is_activated_code")
  code       String   
  codeExpiresAt DateTime
  login      String?
  password   String?
  roleId     String?
  name       String?
  surName    String?
  lastName   String?
  step       Int      @default(1)
  createdAt  DateTime @default(now())

  @@map("pending_user")
}

model Role {
  id          String   @id @default(uuid())
  name        String        @unique
  label       String 
  permissions String[]
  users       User[]   

  @@map("role")
}
